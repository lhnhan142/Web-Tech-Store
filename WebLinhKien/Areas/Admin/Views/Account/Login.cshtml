@model LoginRequest
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập quản trị";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TECHZONE</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="ad-body login-theme">
    <div class="ad-login-wrapper">
        <div class="ad-login-card">
            
            <!-- Cột trái: Form đăng nhập -->
            <section class="ad-login__form">
                <div class="ad-login__box">
                    <h1>Welcome to TECHZONE</h1>
                    <p class="subtitle">Welcome back, Please Login<br>to your Account.</p>

                    <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" novalidate>
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="ad-alert ad-alert--err"></div>

                        <div class="ad-field">
                            <label asp-for="TenDangNhap">Email / Tên đăng nhập</label>
                            <input asp-for="TenDangNhap" autocomplete="username" autofocus class="ad-input custom-input" />
                            <span asp-validation-for="TenDangNhap" class="ad-error"></span>
                        </div>

                        <div class="ad-field" style="margin-bottom: 8px;">
                            <label asp-for="MatKhau">Password</label>
                            <div class="ad-pass">
                                <input asp-for="MatKhau" autocomplete="current-password" class="ad-input custom-input" />
                                <button type="button" data-toggle-pass aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="MatKhau" class="ad-error"></span>
                        </div>

                        <div class="action-buttons">
                            <button type="submit" class="ad-btn btn-login">
                                Login
                            </button>
                        </div>
                        
                        <!-- Ẩn nút ghi nhớ đăng nhập để giống thiết kế, có thể mở lại nếu cần -->
                        <div class="ad-hide">
                            <label class="ad-check">
                                <input asp-for="GhiNho" type="checkbox" checked /> Ghi nhớ đăng nhập
                            </label>
                        </div>
                    </form>

                    <div class="login-footer-links">
                        <a href="#">Terms</a>
                        <a href="#">Plans</a>
                        <a href="#">Contact Us</a>
                    </div>
                </div>
            </section>

            <!-- Cột phải: Hình ảnh & Thương hiệu -->
            <section class="ad-login__brand">
                <div class="brand-content">
                    <a class="ad-brand brand-light" href="~/">
                        <span class="ad-brand__mark"><i class="fa-solid fa-microchip"></i></span>
                        TECHZONE
                    </a>
                    <h2>Chuyên mua bán linh kiện<br>Máy Tính</h2>
                     
                    <!-- Vị trí đặt ảnh minh họa đồ họa (Illustration) -->
                    <div class="illustration-placeholder">
                        <i class="fa-solid fa-users-gear" style="font-size: 120px; color: rgba(255,255,255,0.8); margin-top: 40px;"></i>
                    </div>
                </div>
            </section>

        </div>
    </div>
    <script src="~/js/admin.js" asp-append-version="true"></script>
</body>
</html>