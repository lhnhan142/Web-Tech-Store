@model WebLinhKien.Models.ViewModels.DanhMucListViewModel
@{
    ViewData["Title"] = "Danh mục";
}

<div class="ad-pagehead">
    <div>
        <h1 class="ad-title">Danh mục sản phẩm</h1>
        <p class="ad-subtitle">Danh mục còn sản phẩm thì không xóa được.</p>
    </div>
    <div class="ad-actions">
        <a asp-action="Create" class="ad-btn ad-btn--primary"><i class="fa-solid fa-plus"></i> Thêm danh mục</a>
    </div>
</div>

<partial name="_ThongBao" />

<section class="ad-card">
    <div class="ad-tablebar">
        <span class="ad-tablebar__info">Tổng: <b>@Model.Items.Count</b> danh mục</span>
    </div>
    <div class="ad-tablewrap">
        <table class="ad-table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên danh mục</th>
                    <th class="is-num">Thứ tự</th>
                    <th>Hiển thị</th>
                    <th class="is-num">Số sản phẩm</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dm in Model.Items)
                {
                    var dem = Model.DemSanPham.GetValueOrDefault(dm.MaDanhMuc);
                    <tr>
                        <td class="ad-mono">@dm.MaDanhMuc</td>
                        <td><b>@dm.TenDanhMuc</b></td>
                        <td class="is-num">@dm.Ordering</td>
                        <td>
                            @if (dm.HienThi)
                            {
                                <span class="ad-badge ad-badge--ok">Hiển thị</span>
                            }
                            else
                            {
                                <span class="ad-badge ad-badge--off">Đang ẩn</span>
                            }
                        </td>
                        <td class="is-num">@dem</td>
                        <td class="is-actions">
                            <a asp-action="Edit" asp-route-id="@dm.MaDanhMuc" class="ad-iconlink" title="Sửa" aria-label="Sửa danh mục @dm.TenDanhMuc"><i class="fa-solid fa-pen"></i></a>
                            @if (dem > 0)
                            {
                                <span class="ad-iconlink is-disabled" title="Còn sản phẩm nên không xóa được"><i class="fa-regular fa-trash-can"></i></span>
                            }
                            else
                            {
                                <form asp-action="Xoa" asp-route-id="@dm.MaDanhMuc" method="post" style="display:inline">
                                    <button type="submit" class="ad-iconlink is-danger" title="Xóa" aria-label="Xóa danh mục @dm.TenDanhMuc"
                                            data-confirm="Hành động này không hoàn tác được."
                                            data-confirm-title="Xóa danh mục @dm.TenDanhMuc?"
                                            data-confirm-ok="Xóa danh mục"><i class="fa-regular fa-trash-can"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any())
    {
        <div class="ad-empty"><i class="fa-solid fa-layer-group"></i><strong>Chưa có danh mục nào</strong>Bấm "Thêm danh mục" để bắt đầu.</div>
    }
</section>
