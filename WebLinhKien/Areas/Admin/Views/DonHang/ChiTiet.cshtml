@model WebLinhKien.Models.ViewModels.DonHangChiTietViewModel
@using WebLinhKien.Helpers
@{
    ViewData["Title"] = "Đơn " + Model.Don.MaDon;
    var don = Model.Don;

    // Thanh tiến trình: 4 bước chính; Hoàn trả / Đổi hàng hiện thêm một bước cuối
    var buoc = new[]
    {
        (Ten: "Mới đặt hàng", Icon: "fa-inbox"),
        (Ten: "Đang xử lý", Icon: "fa-gears"),
        (Ten: "Đang giao hàng", Icon: "fa-truck-fast"),
        (Ten: "Đã nhận", Icon: "fa-circle-check")
    };
    var hienTai = don.MaTinhTrang switch
    {
        TinhTrangDonHangFlow.Moi => 0,
        TinhTrangDonHangFlow.DangXuLy => 1,
        TinhTrangDonHangFlow.DangGiaoHang => 2,
        TinhTrangDonHangFlow.DaNhan => 3,
        _ => 4
    };
    var tenHienTai = Model.TinhTrangHienTai?.TenTinhTrang ?? don.MaTinhTrang;
}

<div class="ad-pagehead">
    <h1 class="ad-title">Đơn @don.MaDon <span class="@TinhTrangDonHangFlow.BadgeClass(don.MaTinhTrang)">@tenHienTai</span></h1>
    <div class="ad-actions">
        <button type="button" class="ad-btn" onclick="window.print()"><i class="fa-solid fa-print"></i> In đơn</button>
        <a asp-action="Index" class="ad-btn"><i class="fa-solid fa-arrow-left"></i> Danh sách đơn</a>
    </div>
</div>

<partial name="_ThongBao" />

<div class="ad-grid ad-grid--2-1">
    <div class="ad-stack">
        <section class="ad-card">
            <ol class="ad-steps" aria-label="Tiến trình đơn hàng">
                @for (var i = 0; i < buoc.Length; i++)
                {
                    <li class="@(i < hienTai ? "is-done" : i == hienTai ? "is-current" : "")">
                        <span class="ad-steps__dot"><i class="fa-solid @buoc[i].Icon"></i></span>
                        <span class="ad-steps__label">@buoc[i].Ten</span>
                    </li>
                }
                @if (hienTai == 4)
                {
                    var hoanTra = don.MaTinhTrang == TinhTrangDonHangFlow.HoanTra;
                    <li class="@(hoanTra ? "is-bad" : "is-current")">
                        <span class="ad-steps__dot"><i class="fa-solid @(hoanTra ? "fa-rotate-left" : "fa-arrows-rotate")"></i></span>
                        <span class="ad-steps__label">@tenHienTai</span>
                    </li>
                }
            </ol>
            <div style="height:12px"></div>
        </section>

        <section class="ad-card">
            <div class="ad-card__head"><h2 class="ad-card__title"><i class="fa-solid fa-box-open"></i> Sản phẩm</h2></div>
            <div class="ad-tablewrap">
                <table class="ad-table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="is-num">Đơn giá</th>
                            <th class="is-num">SL</th>
                            <th class="is-num">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in Model.ChiTiet)
                        {
                            <tr>
                                <td>@ct.TenSanPham</td>
                                <td class="is-num">@ct.DonGia.ToVnd()</td>
                                <td class="is-num">@ct.SoLuong</td>
                                <td class="is-num"><b>@ct.ThanhTien.ToVnd()</b></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ad-card__body">
                <dl class="ad-totals">
                    <div><dt>Tiền hàng</dt><dd>@don.TongTienHang.ToVnd()</dd></div>
                    <div><dt>Phí giao hàng</dt><dd>@(don.PhiGiaoHang == 0 ? "Miễn phí" : don.PhiGiaoHang.ToVnd())</dd></div>
                    <div class="is-grand"><dt>Tổng thanh toán</dt><dd>@don.TongThanhToan.ToVnd()</dd></div>
                </dl>
            </div>
        </section>

        <section class="ad-card">
            <div class="ad-card__head"><h2 class="ad-card__title"><i class="fa-solid fa-truck-fast"></i> Thông tin giao hàng</h2></div>
            <div class="ad-card__body">
                <dl class="ad-dl ad-dl--cols">
                    <div><dt>Họ tên</dt><dd>@don.TenKhachHang</dd></div>
                    <div><dt>Số điện thoại</dt><dd><a href="tel:@don.Sdt">@don.Sdt</a></dd></div>
                    <div class="is-wide"><dt>Địa chỉ</dt><dd>@don.DiaChi</dd></div>
                    <div class="is-wide"><dt>Ghi chú</dt><dd>@(string.IsNullOrWhiteSpace(don.GhiChu) ? "(không có)" : don.GhiChu)</dd></div>
                </dl>
            </div>
        </section>
    </div>

    <div class="ad-stack" style="align-content:start">
        <section class="ad-card">
            <div class="ad-card__head">
                <h2 class="ad-card__title"><i class="fa-solid fa-circle-info"></i> Thông tin đơn</h2>
                <span class="@TinhTrangDonHangFlow.BadgeClass(don.MaTinhTrang)">@tenHienTai</span>
            </div>
            <div class="ad-card__body">
                <dl class="ad-dl">
                    <div><dt>Ngày đặt</dt><dd>@don.NgayDat.ToNgayGio()</dd></div>
                    <div><dt>Thanh toán</dt><dd>@(don.MaHinhThucThanhToan == "COD" ? "COD (khi nhận hàng)" : "Chuyển khoản")</dd></div>
                    @if (don.NgayCapNhat.HasValue)
                    {
                        <div><dt>Cập nhật</dt><dd>@don.NgayCapNhat.Value.ToNgayGio()</dd></div>
                    }
                </dl>
            </div>
        </section>

        <section class="ad-card">
            <div class="ad-card__head"><h2 class="ad-card__title"><i class="fa-solid fa-arrows-rotate"></i> Đổi tình trạng</h2></div>
            <div class="ad-card__body">
                @if (Model.TinhTrangTiepTheo.Count == 0)
                {
                    <p class="ad-hint" style="margin:0">Đơn này đã ở tình trạng cuối, không thể đổi tiếp.</p>
                }
                else
                {
                    <div class="ad-flow">
                        @foreach (var t in Model.TinhTrangTiepTheo)
                        {
                            var nguyHiem = t.MaTinhTrang == TinhTrangDonHangFlow.HoanTra;
                            <form asp-action="DoiTinhTrang" asp-route-id="@don.Uid" method="post">
                                <input type="hidden" name="maTinhTrang" value="@t.MaTinhTrang" />
                                @* data-confirm do admin.js xử lý: hỏi lại rồi mới gửi form *@
                                <button type="submit"
                                        data-confirm="@(nguyHiem ? "Đơn sẽ chuyển sang Hoàn trả và không đổi tiếp được nữa." : null)"
                                        data-confirm-title="@(nguyHiem ? "Chuyển đơn sang Hoàn trả?" : null)"
                                        data-confirm-ok="@(nguyHiem ? "Chuyển sang Hoàn trả" : null)"
                                        class="ad-btn ad-btn--block @(nguyHiem ? "ad-btn--danger" : "ad-btn--primary")">
                                    Chuyển sang: @t.TenTinhTrang
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>
