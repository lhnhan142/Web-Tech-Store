@model WebLinhKien.Models.ViewModels.DonHangListViewModel
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="ad-pagehead">
    <div>
        <h1 class="ad-title">Quản lý đơn hàng</h1>
        <p class="ad-subtitle">Theo dõi đơn từ lúc khách đặt đến khi giao xong.</p>
    </div>
</div>

<form asp-action="Index" method="get" class="ad-filter">
    <input type="hidden" name="tinhTrang" value="@Model.MaTinhTrang" />
    <div class="ad-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" name="q" value="@Model.Q" class="ad-input" placeholder="Mã đơn, tên, số điện thoại..." aria-label="Tìm đơn hàng" />
    </div>
    <button type="submit" class="ad-btn ad-btn--primary">Tìm</button>
</form>

@* Phần danh sách được tải lại bằng JavaScript khi có đơn mới nên tách thành partial *@
<div id="danhsach-don">
    @await Html.PartialAsync("_DanhSachDon", Model)
</div>

@section Scripts {
    <script src="~/js/admin-don-hang.js" asp-append-version="true"></script>
}
