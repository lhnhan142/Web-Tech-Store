@model WebLinhKien.Models.ViewModels.DonHangListViewModel
@using WebLinhKien.Helpers

@functions {
    static string TabClass(bool active) =>
        "inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm " +
        (active ? "border-blue-600 bg-blue-600 text-white" : "border-slate-300 bg-white text-slate-700 hover:bg-slate-50");
}

<div class="mb-4 flex flex-wrap gap-2">
    <a asp-action="Index" asp-route-q="@Model.Q" class="@TabClass(string.IsNullOrEmpty(Model.MaTinhTrang))">
        Tất cả <span class="font-semibold">@Model.TongTatCa</span>
    </a>
    @foreach (var t in Model.TinhTrangs)
    {
        var dem = Model.DemTheoTinhTrang.GetValueOrDefault(t.MaTinhTrang);
        <a asp-action="Index" asp-route-tinhTrang="@t.MaTinhTrang" asp-route-q="@Model.Q"
           class="@TabClass(Model.MaTinhTrang == t.MaTinhTrang)">
            @t.TenTinhTrang <span class="font-semibold">@dem</span>
        </a>
    }
</div>

<div class="overflow-x-auto rounded-xl bg-white shadow-sm">
    <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-500">
            <tr>
                <th class="px-4 py-3 font-medium">Mã đơn</th>
                <th class="px-4 py-3 font-medium">Khách hàng</th>
                <th class="px-4 py-3 font-medium">Tổng thanh toán</th>
                <th class="px-4 py-3 font-medium">Thanh toán</th>
                <th class="px-4 py-3 font-medium">Tình trạng</th>
                <th class="px-4 py-3 font-medium">Ngày đặt</th>
                <th class="px-4 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var don in Model.Items)
            {
                <tr data-ma-don="@don.MaDon" class="transition-colors duration-700 hover:bg-slate-50">
                    <td class="px-4 py-3 font-medium">
                        <a asp-action="ChiTiet" asp-route-id="@don.Uid" class="text-blue-600 hover:underline">@don.MaDon</a>
                    </td>
                    <td class="px-4 py-3">
                        @don.TenKhachHang
                        <div class="text-xs text-slate-500">@don.Sdt</div>
                    </td>
                    <td class="px-4 py-3 font-semibold">@don.TongThanhToan.ToVnd()</td>
                    <td class="px-4 py-3">@(don.MaHinhThucThanhToan == "COD" ? "COD" : "Chuyển khoản")</td>
                    <td class="px-4 py-3">
                        <span class="@TinhTrangDonHangFlow.BadgeClass(don.MaTinhTrang)">@Model.TenTinhTrang(don.MaTinhTrang)</span>
                    </td>
                    <td class="px-4 py-3 text-slate-600">@don.NgayDat.ToNgayGio()</td>
                    <td class="px-4 py-3 text-right">
                        <a asp-action="ChiTiet" asp-route-id="@don.Uid" class="text-blue-600 hover:underline">Xem</a>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="7" class="px-4 py-10 text-center text-slate-500">Không có đơn hàng nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="mt-4 flex items-center justify-between text-sm text-slate-600">
        <span>Trang @Model.Page / @Model.TotalPages (@Model.TotalItems đơn)</span>
        <div class="flex gap-2">
            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-route-tinhTrang="@Model.MaTinhTrang" asp-route-q="@Model.Q" asp-route-page="@(Model.Page - 1)"
                   class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 hover:bg-slate-50">Trước</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-tinhTrang="@Model.MaTinhTrang" asp-route-q="@Model.Q" asp-route-page="@(Model.Page + 1)"
                   class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 hover:bg-slate-50">Sau</a>
            }
        </div>
    </div>
}
