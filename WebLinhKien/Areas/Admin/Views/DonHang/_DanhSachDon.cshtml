@model WebLinhKien.Models.ViewModels.DonHangListViewModel
@using WebLinhKien.Helpers

<div class="ad-chips">
    <a asp-action="Index" asp-route-q="@Model.Q" class="@("ad-chip" + (string.IsNullOrEmpty(Model.MaTinhTrang) ? " is-active" : ""))">
        Tất cả <b>@Model.TongTatCa</b>
    </a>
    @foreach (var t in Model.TinhTrangs)
    {
        var dem = Model.DemTheoTinhTrang.GetValueOrDefault(t.MaTinhTrang);
        <a asp-action="Index" asp-route-tinhTrang="@t.MaTinhTrang" asp-route-q="@Model.Q"
           class="@("ad-chip" + (Model.MaTinhTrang == t.MaTinhTrang ? " is-active" : ""))">
            @t.TenTinhTrang <b>@dem</b>
        </a>
    }
</div>

<section class="ad-card">
    <div class="ad-tablebar">
        <span class="ad-tablebar__info">Tổng: <b>@Model.TotalItems</b> đơn</span>
    </div>

    <div class="ad-tablewrap">
        <table class="ad-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th class="is-num">Tổng thanh toán</th>
                    <th>Thanh toán</th>
                    <th>Tình trạng</th>
                    <th>Ngày đặt</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var don in Model.Items)
                {
                    <tr data-ma-don="@don.MaDon">
                        <td><a asp-action="ChiTiet" asp-route-id="@don.Uid" class="ad-rowlink">@don.MaDon</a></td>
                        <td class="is-nowrap">@don.TenKhachHang<span class="ad-sub">@don.Sdt</span></td>
                        <td class="is-num"><b>@don.TongThanhToan.ToVnd()</b></td>
                        <td class="is-nowrap">@(don.MaHinhThucThanhToan == "COD" ? "COD" : "Chuyển khoản")</td>
                        <td><span class="@TinhTrangDonHangFlow.BadgeClass(don.MaTinhTrang)">@Model.TenTinhTrang(don.MaTinhTrang)</span></td>
                        <td class="is-nowrap">@don.NgayDat.ToNgayGio()</td>
                        <td class="is-actions">
                            <a asp-action="ChiTiet" asp-route-id="@don.Uid" class="ad-iconlink" title="Xem chi tiết" aria-label="Xem chi tiết đơn @don.MaDon"><i class="fa-regular fa-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="ad-empty">
            <i class="fa-regular fa-folder-open"></i>
            <strong>Không có đơn hàng nào</strong>
            Thử đổi tình trạng hoặc từ khóa khác.
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="ad-pager">
            <span>Trang @Model.Page / @Model.TotalPages (@Model.TotalItems đơn)</span>
            <div class="ad-pager__btns">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-tinhTrang="@Model.MaTinhTrang" asp-route-q="@Model.Q" asp-route-page="@(Model.Page - 1)"
                       class="ad-pager__btn" aria-label="Trang trước"><i class="fa-solid fa-chevron-left"></i></a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-tinhTrang="@Model.MaTinhTrang" asp-route-q="@Model.Q" asp-route-page="@(Model.Page + 1)"
                       class="ad-pager__btn" aria-label="Trang sau"><i class="fa-solid fa-chevron-right"></i></a>
                }
            </div>
        </div>
    }
</section>
