@model WebLinhKien.Models.ViewModels.Client.ProductDetailViewModel
@using WebLinhKien.Helpers
@{
    ViewData["Title"] = $"{Model.SanPham.TenSanPham} - TECHZONE";
    var allImages = new List<string>();
    if (!string.IsNullOrEmpty(Model.SanPham.AnhDaiDien))
    {
        allImages.Add(Model.SanPham.AnhDaiDien);
    }
    foreach (var img in Model.HinhAnh)
    {
        if (!allImages.Contains(img.DuongDan))
        {
            allImages.Add(img.DuongDan);
        }
    }
    var firstImage = allImages.FirstOrDefault();
}

<!-- Breadcrumb điều hướng -->
@await Html.PartialAsync("_Breadcrumb", Model.Breadcrumbs)

<div class="tz-container pb-5">
    <!-- KHUNG CHÍNH: HÌNH ẢNH (BÊN TRÁI) VÀ THÔNG TIN ĐẶT HÀNG (BÊN PHẢI) -->
    <div class="row g-4 mb-5">
        <!-- 1. KHU VỰC HÌNH ẢNH (GALLERY) -->
        <div class="col-lg-5 col-md-6">
            <div class="tz-detail-gallery-wrap bg-white p-3 p-xl-4 rounded-3 border">
                <!-- Ảnh lớn chính -->
                <div class="tz-detail-main-img-box position-relative">
                    <!-- Badges -->
                    <div class="tz-card-badges">
                        @if (Model.CoGiamGia)
                        {
                            <span class="tz-badge tz-badge-discount">-@Model.PhanTramGiam%</span>
                        }
                        @if (Model.SanPham.NoiBat)
                        {
                            <span class="tz-badge tz-badge-accent"><i class="fa-solid fa-fire"></i> HOT</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(firstImage))
                    {
                        <img id="tz-detail-main-img" src="@firstImage"
                             alt="@Model.SanPham.TenSanPham"
                             class="tz-detail-main-img"
                             onerror="this.style.display='none';document.getElementById('tz-detail-fallback-box').style.display='flex';" />
                        <div id="tz-detail-fallback-box" class="tz-thumb-fallback" style="display: none; height: 380px;">
                            <i class="fa-solid @Model.IconDanhMuc"></i>
                        </div>
                    }
                    else
                    {
                        <div class="tz-thumb-fallback" style="height: 380px;">
                            <i class="fa-solid @Model.IconDanhMuc"></i>
                        </div>
                    }
                </div>

                <!-- Gallery ảnh nhỏ bên dưới -->
                @if (allImages.Count > 1)
                {
                    <div class="tz-detail-thumbs-list mt-3 d-flex align-items-center gap-2 overflow-auto pb-2">
                        @for (int i = 0; i < allImages.Count; i++)
                        {
                            var imgUrl = allImages[i];
                            <button type="button" class="tz-detail-thumb-item @(i == 0 ? "active" : "")"
                                    onclick="tzChangeMainImage(this, '@imgUrl')">
                                <img src="@imgUrl" alt="Ảnh phụ @(i + 1)" onerror="this.parentElement.style.display='none';" />
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 2. KHU VỰC THÔNG TIN SẢN PHẨM & MUA HÀNG -->
        <div class="col-lg-7 col-md-6">
            <div class="tz-detail-info-wrap bg-white p-4 rounded-3 border">
                <!-- Meta: Thương hiệu & SKU -->
                <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
                    @if (Model.ThuongHieu != null)
                    {
                        <a href="~/SanPham?thuongHieu=@Model.ThuongHieu.MaThuongHieu" class="tz-badge tz-badge-dark text-decoration-none">
                            <i class="fa-solid fa-tag me-1"></i>Hãng: @Model.ThuongHieu.TenThuongHieu
                        </a>
                    }
                    @if (Model.DanhMuc != null)
                    {
                        <a href="~/SanPham?danhMuc=@Model.DanhMuc.MaDanhMuc" class="tz-badge tz-badge-outline text-decoration-none text-muted border">
                            <i class="fa-solid @Model.IconDanhMuc me-1"></i>@Model.DanhMuc.TenDanhMuc
                        </a>
                    }
                    <span class="tz-card-sku">SKU: @Model.SanPham.MaSanPham</span>
                </div>

                <!-- Tên sản phẩm -->
                <h1 class="h3 fw-bold text-dark mb-3">@Model.SanPham.TenSanPham</h1>

                <!-- Trạng thái kho & Bảo hành -->
                <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom flex-wrap small">
                    <div>
                        @if (Model.ConHang)
                        {
                            <span class="text-success fw-bold">
                                <i class="fa-solid fa-circle-check me-1"></i>Còn hàng (@Model.SanPham.TonKho trong kho)
                            </span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold">
                                <i class="fa-solid fa-circle-xmark me-1"></i>Tạm hết hàng
                            </span>
                        }
                    </div>
                    <div class="text-muted">|</div>
                    <div class="text-muted">
                        <i class="fa-solid fa-shield-halved text-success me-1"></i>Bảo hành: <strong>@(Model.SanPham.BaoHanhThang > 0 ? $"{Model.SanPham.BaoHanhThang} tháng" : "12 tháng")</strong>
                    </div>
                    <div class="text-muted">|</div>
                    <div class="text-warning">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <span class="text-muted ms-1">(5.0 Đánh giá cao)</span>
                    </div>
                </div>

                <!-- Giá bán & Tiết kiệm -->
                <div class="tz-detail-price-box p-3 rounded-3 mb-3" style="background-color: var(--tz-bg);">
                    <div class="d-flex align-items-baseline gap-3">
                        <span class="h2 fw-extrabold text-danger mb-0">@Model.SanPham.GiaBan.ToVnd()</span>
                        @if (Model.CoGiamGia)
                        {
                            <span class="text-muted text-decoration-line-through fs-5">@Model.SanPham.GiaGoc.ToVnd()</span>
                            <span class="tz-badge tz-badge-discount">-@Model.PhanTramGiam%</span>
                        }
                    </div>
                    @if (Model.CoGiamGia)
                    {
                        <div class="text-success small fw-semibold mt-1">
                            <i class="fa-solid fa-tags me-1"></i>Tiết kiệm ngay: @Model.SoTienTietKiem.ToVnd() khi mua online hôm nay
                        </div>
                    }
                    <div class="text-muted small mt-1">
                        <i class="fa-solid fa-receipt me-1"></i>Giá đã bao gồm thuế VAT 10% và đầy đủ hóa đơn chứng từ.
                    </div>
                </div>

                <!-- Mô tả ngắn nếu có -->
                @if (!string.IsNullOrWhiteSpace(Model.SanPham.MoTaNgan))
                {
                    <div class="tz-detail-short-desc mb-3 p-3 rounded-2 border bg-light small">
                        <div class="fw-bold mb-1 text-dark"><i class="fa-solid fa-circle-info text-primary me-1"></i>Đặc điểm nổi bật:</div>
                        <p class="mb-0 text-muted">@Model.SanPham.MoTaNgan</p>
                    </div>
                }

                <!-- Cam kết quyền lợi khách hàng -->
                <div class="tz-detail-perks mb-4 p-3 rounded-2 border small" style="background-color: #FAFAFA;">
                    <div class="row g-2">
                        <div class="col-6">
                            <i class="fa-solid fa-check text-success me-1"></i>100% Hàng chính hãng nguyên seal
                        </div>
                        <div class="col-6">
                            <i class="fa-solid fa-truck-fast text-warning me-1"></i>Giao hàng hỏa tốc trong 2h
                        </div>
                        <div class="col-6">
                            <i class="fa-solid fa-rotate-left text-primary me-1"></i>1 đổi 1 trong 30 ngày nếu lỗi
                        </div>
                        <div class="col-6">
                            <i class="fa-solid fa-screwdriver-wrench text-secondary me-1"></i>Hỗ trợ lắp đặt máy tính miễn phí
                        </div>
                    </div>
                </div>

                <!-- Form Đặt hàng & Chọn số lượng -->
                <form id="tz-add-to-cart-form" onsubmit="return false;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="uid" value="@Model.SanPham.Uid" />

                    @if (Model.ConHang)
                    {
                        <!-- Bộ chọn số lượng -->
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <label class="fw-semibold text-dark small">Số lượng mua:</label>
                            <div class="tz-qty-selector d-flex align-items-center">
                                <button type="button" class="tz-qty-btn" onclick="tzChangeQty(-1)"><i class="fa-solid fa-minus"></i></button>
                                <input type="number" id="tz-qty-input" name="soLuong" value="1" min="1" max="@Math.Min(10, Model.SanPham.TonKho)" class="tz-qty-input" />
                                <button type="button" class="tz-qty-btn" onclick="tzChangeQty(1)"><i class="fa-solid fa-plus"></i></button>
                            </div>
                            <span class="text-muted small">(Tối đa 10 sản phẩm/đơn)</span>
                        </div>

                        <!-- Cụm nút Mua Ngay & Thêm Giỏ Hàng -->
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <button type="button" class="tz-btn tz-btn-outline tz-btn-lg flex-grow-1"
                                    onclick="tzHandleAddToCart(false)">
                                <i class="fa-solid fa-cart-plus me-1"></i>
                                <span>Thêm vào giỏ hàng</span>
                            </button>
                            <button type="button" class="tz-btn tz-btn-accent tz-btn-lg flex-grow-1"
                                    onclick="tzHandleAddToCart(true)">
                                <i class="fa-solid fa-bolt me-1"></i>
                                <span>Mua ngay</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- Trạng thái hết hàng -->
                        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span>Sản phẩm hiện đang tạm hết hàng tại kho. Vui lòng quay lại sau hoặc liên hệ Hotline để đặt trước.</span>
                        </div>
                        <a href="tel:19008888" class="tz-btn tz-btn-secondary tz-btn-lg w-100">
                            <i class="fa-solid fa-phone me-1"></i>Liên hệ Hotline đặt trước (1900 8888)
                        </a>
                    }
                </form>

                <!-- Nút phụ: Yêu thích & So sánh -->
                <div class="d-flex align-items-center gap-4 mt-3 pt-3 border-top small">
                    <button type="button" class="btn btn-link p-0 text-muted text-decoration-none tz-btn-wishlist"
                            data-wishlist-uid="@Model.SanPham.Uid"
                            onclick="tzToggleWishlist(this, { uid: @Model.SanPham.Uid, ten: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SanPham.TenSanPham))', gia: '@Model.SanPham.GiaBan.ToVnd()', anh: '@Model.SanPham.AnhDaiDien', url: '/SanPham/ChiTiet/@Model.SanPham.Uid' })">
                        <i class="fa-regular fa-heart text-danger me-1"></i><span>Thêm vào danh sách yêu thích</span>
                    </button>
                    <button type="button" class="btn btn-link p-0 text-muted text-decoration-none tz-btn-compare"
                            data-compare-uid="@Model.SanPham.Uid"
                            onclick="tzToggleCompare(this, { uid: @Model.SanPham.Uid, ten: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SanPham.TenSanPham))', gia: '@Model.SanPham.GiaBan.ToVnd()', anh: '@Model.SanPham.AnhDaiDien', url: '/SanPham/ChiTiet/@Model.SanPham.Uid' })">
                        <i class="fa-solid fa-code-compare text-primary me-1"></i><span>So sánh sản phẩm</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS THÔNG TIN SẢN PHẨM: MÔ TẢ, THÔNG SỐ KỸ THUẬT, CHÍNH SÁCH BẢO HÀNH -->
    <div class="tz-detail-tabs-wrap bg-white rounded-3 border mb-5 overflow-hidden">
        <ul class="nav nav-tabs tz-detail-nav-tabs" id="productTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc-pane" type="button" role="tab" aria-selected="true">
                    <i class="fa-solid fa-align-left me-2"></i>Mô Tả Chi Tiết
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs-pane" type="button" role="tab" aria-selected="false">
                    <i class="fa-solid fa-list-check me-2"></i>Thông Số Kỹ Thuật
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="warranty-tab" data-bs-toggle="tab" data-bs-target="#warranty-pane" type="button" role="tab" aria-selected="false">
                    <i class="fa-solid fa-shield-halved me-2"></i>Chính Sách Bảo Hành
                </button>
            </li>
        </ul>

        <div class="tab-content p-4" id="productTabContent">
            <!-- TAB 1: MÔ TẢ CHI TIẾT (LÀM SẠCH XSS AN TOÀN) -->
            <div class="tab-pane fade show active" id="desc-pane" role="tabpanel" aria-labelledby="desc-tab">
                @if (!string.IsNullOrWhiteSpace(Model.SanPham.MoTa))
                {
                    <div class="tz-product-description-content">
                        @Html.Raw(HtmlSanitizerHelper.Sanitize(Model.SanPham.MoTa))
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fa-regular fa-file-lines fa-2x mb-2 d-block"></i>
                        <span>Nội dung mô tả chi tiết của sản phẩm đang được cập nhật thêm.</span>
                    </div>
                }
            </div>

            <!-- TAB 2: BẢNG THÔNG SỐ KỸ THUẬT TỪ DATABASE -->
            <div class="tab-pane fade" id="specs-pane" role="tabpanel" aria-labelledby="specs-tab">
                @if (Model.ThongSo != null && Model.ThongSo.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover border tz-specs-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 35%; background-color: var(--tz-bg);">Thuộc tính thông số</th>
                                    <th style="background-color: var(--tz-bg);">Giá trị chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ts in Model.ThongSo)
                                {
                                    <tr>
                                        <td class="fw-semibold text-dark">@ts.TenThongSo</td>
                                        <td class="text-muted">@ts.GiaTri</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fa-solid fa-table-list fa-2x mb-2 d-block"></i>
                        <span>Chưa có thông số kỹ thuật chi tiết cho sản phẩm này.</span>
                    </div>
                }
            </div>

            <!-- TAB 3: CHÍNH SÁCH BẢO HÀNH -->
            <div class="tab-pane fade" id="warranty-pane" role="tabpanel" aria-labelledby="warranty-tab">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-dark"><i class="fa-solid fa-circle-check text-success me-2"></i>Quy định bảo hành chính hãng:</h6>
                        <ul class="text-muted small ps-3">
                            <li class="mb-2">Sản phẩm được bảo hành chính hãng <strong>@(Model.SanPham.BaoHanhThang > 0 ? $"{Model.SanPham.BaoHanhThang} tháng" : "12 tháng")</strong> kể từ ngày mua.</li>
                            <li class="mb-2">Sản phẩm phải còn nguyên vẹn tem bảo hành của TECHZONE và nhà phân phối, không có dấu hiệu móp méo, cháy nổ, gãy chân socket hoặc dính chất lỏng.</li>
                            <li class="mb-2">Hỗ trợ chính sách <strong>1 đổi 1 trong 30 ngày đầu</strong> nếu phát sinh lỗi phần cứng do nhà sản xuất.</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-dark"><i class="fa-solid fa-location-dot text-primary me-2"></i>Địa điểm tiếp nhận bảo hành:</h6>
                        <p class="text-muted small mb-2">Showroom TECHZONE: 123 Lê Lợi, Phường Bến Thành, Quận 1, TP. Hồ Chí Minh.</p>
                        <p class="text-muted small mb-0">Hotline kỹ thuật: <strong>0987.654.321</strong> (Hỗ trợ từ 08:00 - 21:30 tất cả các ngày trong tuần).</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SẢN PHẨM LIÊN QUAN CÙNG DANH MỤC -->
    @if (Model.SanPhamLienQuan != null && Model.SanPhamLienQuan.Any())
    {
        <section class="tz-related-products-section">
            <div class="tz-section-header">
                <div class="tz-section-title-wrap">
                    <span class="tz-section-badge"><i class="fa-solid fa-cubes"></i> Khám phá thêm</span>
                    <h2 class="tz-section-title">Sản Phẩm Cùng Phân Khúc</h2>
                    <p class="tz-section-subtitle">Các dòng linh kiện tương đương cùng danh mục bạn có thể quan tâm</p>
                </div>
                @if (Model.DanhMuc != null)
                {
                    <a href="~/SanPham?danhMuc=@Model.DanhMuc.MaDanhMuc" class="tz-section-viewall">
                        <span>Xem tất cả @Model.DanhMuc.TenDanhMuc</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                }
            </div>

            <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4">
                @foreach (var related in Model.SanPhamLienQuan)
                {
                    <div class="col">
                        @await Html.PartialAsync("_ProductCard", related)
                    </div>
                }
            </div>
        </section>
    }

    <!-- SẢN PHẨM ĐÃ XEM GẦN ĐÂY -->
    <section id="tz-recently-viewed-section" class="tz-recently-viewed-section mt-5" style="display: none;">
        <div class="tz-section-header">
            <div class="tz-section-title-wrap">
                <span class="tz-section-badge"><i class="fa-solid fa-clock-rotate-left"></i> Lịch sử duyệt</span>
                <h2 class="tz-section-title">Sản Phẩm Bạn Đã Xem Gần Đây</h2>
                <p class="tz-section-subtitle">Danh sách các linh kiện bạn vừa tham khảo tại TECHZONE</p>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="tzClearRecentlyViewed()">
                <i class="fa-solid fa-trash me-1"></i>Xóa lịch sử đã xem
            </button>
        </div>
        <div id="tz-recently-viewed-grid" class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4"></div>
    </section>
</div>

@section Styles {
    <style>
        .tz-detail-main-img-box {
            width: 100%;
            aspect-ratio: 1 / 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #FAFAFA;
            border-radius: var(--tz-radius-md);
            overflow: hidden;
            border: 1px solid var(--tz-border);
        }
        .tz-detail-main-img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
            transition: transform 0.3s ease;
        }
        .tz-detail-main-img:hover {
            transform: scale(1.05);
        }
        .tz-detail-thumb-item {
            width: 64px;
            height: 64px;
            padding: 2px;
            background-color: #fff;
            border: 2px solid var(--tz-border);
            border-radius: var(--tz-radius-sm);
            cursor: pointer;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--tz-transition-fast);
        }
        .tz-detail-thumb-item img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .tz-detail-thumb-item:hover, .tz-detail-thumb-item.active {
            border-color: var(--tz-accent);
            box-shadow: 0 0 6px rgba(249, 115, 22, 0.4);
        }
        .tz-qty-selector {
            border: 1.5px solid var(--tz-border);
            border-radius: var(--tz-radius-sm);
            overflow: hidden;
            background: #fff;
        }
        .tz-qty-btn {
            width: 36px;
            height: 36px;
            background: var(--tz-bg);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--tz-text);
            transition: var(--tz-transition-fast);
        }
        .tz-qty-btn:hover {
            background-color: var(--tz-accent);
            color: #fff;
        }
        .tz-qty-input {
            width: 50px;
            height: 36px;
            border: none;
            text-align: center;
            font-weight: 700;
            font-size: 0.9375rem;
            outline: none;
        }
        .tz-detail-nav-tabs .nav-link {
            font-weight: 700;
            font-size: 0.9375rem;
            color: var(--tz-muted);
            border: none;
            padding: 1rem 1.5rem;
            border-bottom: 3px solid transparent;
        }
        .tz-detail-nav-tabs .nav-link.active {
            color: var(--tz-accent);
            border-bottom-color: var(--tz-accent);
            background-color: transparent;
        }
        .tz-product-description-content {
            font-size: 0.95rem;
            line-height: 1.8;
            color: var(--tz-text);
        }
        .tz-product-description-content img {
            max-width: 100%;
            border-radius: var(--tz-radius-sm);
            margin: 1rem 0;
        }
        .tz-specs-table th, .tz-specs-table td {
            padding: 0.85rem 1rem;
            font-size: 0.9rem;
        }
    </style>
}

@section Scripts {
    <script>
        // Chuyển ảnh lớn khi click vào thumbnail
        function tzChangeMainImage(btn, url) {
            const mainImg = document.getElementById('tz-detail-main-img');
            if (mainImg) {
                mainImg.style.opacity = '0.3';
                setTimeout(() => {
                    mainImg.src = url;
                    mainImg.style.opacity = '1';
                }, 150);
            }
            document.querySelectorAll('.tz-detail-thumb-item').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        // Tăng giảm số lượng
        function tzChangeQty(delta) {
            const input = document.getElementById('tz-qty-input');
            if (!input) return;
            let current = parseInt(input.value) || 1;
            let min = parseInt(input.min) || 1;
            let max = parseInt(input.max) || 10;
            let next = current + delta;
            if (next >= min && next <= max) {
                input.value = next;
            }
        }

        // Xử lý Thêm vào giỏ & Mua ngay (Ajax POST)
        function tzHandleAddToCart(muaNgay) {
            const form = document.getElementById('tz-add-to-cart-form');
            if (!form) return;

            const formData = new FormData(form);
            formData.append('muaNgay', muaNgay);

            fetch('/SanPham/ThemVaoGio', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Cập nhật số lượng giỏ hàng trên header
                    const badge = document.getElementById('tz-header-cart-count');
                    if (badge && data.totalCount !== undefined) {
                        badge.textContent = data.totalCount;
                    }

                    if (muaNgay && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        TzToast.success('Giỏ hàng', data.message || 'Đã thêm sản phẩm vào giỏ hàng!');
                    }
                } else {
                    TzToast.error('Không thành công', data.message || 'Không thể thêm sản phẩm vào giỏ.');
                }
            })
            .catch(() => {
                TzToast.error('Lỗi', 'Không thể kết nối đến máy chủ. Vui lòng thử lại.');
            });
        }

        // Tự động ghi nhận sản phẩm vào danh sách đã xem
        document.addEventListener('DOMContentLoaded', function () {
            tzRecordRecentlyViewed({
                uid: @Model.SanPham.Uid,
                ten: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SanPham.TenSanPham))',
                gia: '@Model.SanPham.GiaBan.ToVnd()',
                anh: '@Model.SanPham.AnhDaiDien',
                icon: '@Model.IconDanhMuc',
                url: '/SanPham/ChiTiet/@Model.SanPham.Uid'
            });
            tzRenderRecentlyViewed(@Model.SanPham.Uid);
        });
    </script>
}

