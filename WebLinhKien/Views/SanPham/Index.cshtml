@model WebLinhKien.Models.ViewModels.Client.ProductListViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<!-- Breadcrumbs -->
@await Html.PartialAsync("_Breadcrumb", Model.Breadcrumbs)

<div class="tz-container pb-5">
    <!-- 1. Tiêu đề Trang & Mô tả -->
    <div class="tz-category-header mb-4 p-4 rounded-3 bg-white border">
        <div class="d-flex align-items-center gap-3">
            @if (Model.CurrentCategory != null)
            {
                <div class="tz-cat-icon" style="width: 50px; height: 50px; font-size: 1.35rem;">
                    <i class="fa-solid @CategoryIconHelper.GetIcon(Model.CurrentCategory.MaDanhMuc)"></i>
                </div>
            }
            else if (Model.CurrentBrand != null)
            {
                <div class="tz-cat-icon" style="width: 50px; height: 50px; font-size: 1.35rem;">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
            }
            else if (!string.IsNullOrEmpty(Model.Filter.Q))
            {
                <div class="tz-cat-icon" style="width: 50px; height: 50px; font-size: 1.35rem;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
            }
            <div>
                <h1 class="h3 fw-bold mb-1 text-dark">@Model.PageTitle</h1>
                <p class="text-muted mb-0 small">@Model.PageDescription</p>
            </div>
        </div>

        <!-- Các huy hiệu bộ lọc đang kích hoạt -->
        @if (Model.HasActiveFilters)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap mt-3 pt-3 border-top">
                <span class="text-muted small fw-semibold">Đang lọc theo:</span>

                @if (!string.IsNullOrEmpty(Model.Filter.Q))
                {
                    <a href="~/SanPham?@GetQueryWithout("q")" class="tz-filter-pill" title="Bỏ lọc từ khóa">
                        <span>Từ khóa: "@Model.Filter.Q"</span>
                        <i class="fa-solid fa-xmark ms-1"></i>
                    </a>
                }
                @if (Model.CurrentCategory != null)
                {
                    <a href="~/SanPham?@GetQueryWithout("danhMuc", "thuongHieu", "ts")" class="tz-filter-pill" title="Bỏ lọc danh mục">
                        <span>Danh mục: @Model.CurrentCategory.TenDanhMuc</span>
                        <i class="fa-solid fa-xmark ms-1"></i>
                    </a>
                }
                @if (Model.CurrentBrand != null)
                {
                    <a href="~/SanPham?@GetQueryWithout("thuongHieu")" class="tz-filter-pill" title="Bỏ lọc thương hiệu">
                        <span>Hãng: @Model.CurrentBrand.TenThuongHieu</span>
                        <i class="fa-solid fa-xmark ms-1"></i>
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Filter.PriceRange))
                {
                    <a href="~/SanPham?@GetQueryWithout("priceRange", "minPrice", "maxPrice")" class="tz-filter-pill" title="Bỏ lọc mức giá">
                        <span>Mức giá: @GetPriceRangeLabel(Model.Filter.PriceRange)</span>
                        <i class="fa-solid fa-xmark ms-1"></i>
                    </a>
                }
                else if (Model.Filter.MinPrice.HasValue || Model.Filter.MaxPrice.HasValue)
                {
                    var priceText = (Model.Filter.MinPrice.HasValue && Model.Filter.MaxPrice.HasValue)
                        ? $"{Model.Filter.MinPrice.Value.ToVnd()} - {Model.Filter.MaxPrice.Value.ToVnd()}"
                        : (Model.Filter.MinPrice.HasValue ? $"Từ {Model.Filter.MinPrice.Value.ToVnd()}" : $"Tối đa {Model.Filter.MaxPrice?.ToVnd()}");
                    <a href="~/SanPham?@GetQueryWithout("minPrice", "maxPrice", "priceRange")" class="tz-filter-pill" title="Bỏ lọc giá tùy chỉnh">
                        <span>Giá: @priceText</span>
                        <i class="fa-solid fa-xmark ms-1"></i>
                    </a>
                }
                @if (Model.Filter.ConHang == true)
                {
                    <a href="~/SanPham?@GetQueryWithout("conHang")" class="tz-filter-pill" title="Bỏ lọc tình trạng kho">
                        <span>Chỉ còn hàng</span>
                        <i class="fa-solid fa-xmark ms-1"></i>
                    </a>
                }

                @foreach (var specToken in Model.Filter.Ts ?? new List<string>())
                {
                    var specInfo = SpecFilterDefinitions.Describe(Model.Filter.DanhMuc, specToken);
                    if (specInfo == null) { continue; }
                    <a href="~/SanPham?@GetQueryWithoutSpec(specToken)" class="tz-filter-pill" title="Bỏ lọc thông số">
                        <span>@specInfo.Value.Group: @specInfo.Value.Option</span>
                        <i class="fa-solid fa-xmark ms-1"></i>
                    </a>
                }

                <a href="~/SanPham" class="text-danger small fw-bold text-decoration-none ms-2">
                    <i class="fa-solid fa-rotate-left me-1"></i>Xóa tất cả
                </a>
            </div>
        }
    </div>

    <!-- 2. Bố cục 2 cột: Sidebar Bộ Lọc & Danh Sách Sản Phẩm -->
    <div class="row g-4">
        <!-- CỘT TRÁI: SIDEBAR BỘ LỌC DÙNG CHUNG -->
        <div class="col-lg-3 col-md-4">
            <partial name="_FilterPanel" model="Model.ToFilterPanelViewModel()" />
        </div>

        <!-- CỘT PHẢI: THANH ĐIỀU HƯỚNG & LƯỚI SẢN PHẨM -->
        <div class="col-lg-9 col-md-8">
            <!-- Top Toolbar: Sắp xếp, Phân trang và Thống kê -->
            <div class="tz-toolbar bg-white p-3 rounded-3 border mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="tz-toolbar-left">
                    <span class="text-muted small">
                        Hiển thị <strong>@Model.PagedProducts.Items.Count</strong> trên tổng số
                        <strong>@Model.PagedProducts.TotalItems</strong> sản phẩm
                    </span>
                </div>

                <div class="tz-toolbar-right d-flex align-items-center gap-3">
                    <!-- Dropdown Sắp xếp -->
                    <div class="d-flex align-items-center gap-2">
                        <label for="tz-sort-select" class="small text-muted text-nowrap fw-semibold">Sắp xếp:</label>
                        <select id="tz-sort-select" class="form-select form-select-sm" style="min-width: 170px;"
                                onchange="applySort(this.value)">
                            <!option value="default" @(Model.Filter.Sort == "default" ? "selected" : "")>Mặc định (Nổi bật)</!option>
                            <!option value="gia-tang" @(Model.Filter.Sort == "gia-tang" ? "selected" : "")>Giá: Thấp đến Cao</!option>
                            <!option value="gia-giam" @(Model.Filter.Sort == "gia-giam" ? "selected" : "")>Giá: Cao đến Thấp</!option>
                            <!option value="moi-nhat" @(Model.Filter.Sort == "moi-nhat" ? "selected" : "")>Mới nhất về kho</!option>
                            <!option value="ten-az" @(Model.Filter.Sort == "ten-az" ? "selected" : "")>Tên: A – Z</!option>
                        </select>
                    </div>

                    <!-- Dropdown Chọn số sản phẩm/trang -->
                    <div class="d-flex align-items-center gap-2">
                        <label for="tz-pagesize-select" class="small text-muted text-nowrap fw-semibold">Hiển thị:</label>
                        <select id="tz-pagesize-select" class="form-select form-select-sm" style="width: 80px;"
                                onchange="applyPageSize(this.value)">
                            <!option value="12" @(Model.Filter.PageSize == 12 ? "selected" : "")>12</!option>
                            <!option value="24" @(Model.Filter.PageSize == 24 ? "selected" : "")>24</!option>
                            <!option value="36" @(Model.Filter.PageSize == 36 ? "selected" : "")>36</!option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Lưới Sản Phẩm -->
            @if (Model.PagedProducts.Items.Any())
            {
                <div class="row g-3 row-cols-2 row-cols-sm-2 row-cols-md-2 row-cols-lg-3">
                    @foreach (var product in Model.PagedProducts.Items)
                    {
                        <div class="col">
                            @await Html.PartialAsync("_ProductCard", product)
                        </div>
                    }
                </div>

                <!-- Phân trang -->
                @await Html.PartialAsync("_Pagination", new PaginationViewModel
                {
                    Page = Model.PagedProducts.Page,
                    TotalPages = Model.PagedProducts.TotalPages,
                    TotalItems = Model.PagedProducts.TotalItems,
                    PageSize = Model.PagedProducts.PageSize,
                    BaseUrl = Url.Action("Index", "SanPham") ?? "/SanPham",
                    RouteValues = Model.Filter.ToRouteDictionary()
                })
            }
            else
            {
                <!-- Trạng thái không có kết quả (Empty State) -->
                @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                {
                    Icon = "fa-magnifying-glass",
                    Title = "Không tìm thấy sản phẩm phù hợp",
                    Description = "Rất tiếc, không có linh kiện nào thỏa mãn các điều kiện tìm kiếm hoặc bộ lọc hiện tại của bạn. Vui lòng thử lại với các tiêu chí khác.",
                    ActionText = "Xóa tất cả bộ lọc",
                    ActionUrl = "/SanPham"
                })
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function applySort(val) {
            const form = document.querySelector('form[id$="-filter-form"]');
            if (form) {
                form.querySelector('input[name="sort"]').value = val;
                form.submit();
            }
        }

        function applyPageSize(val) {
            const form = document.querySelector('form[id$="-filter-form"]');
            if (form) {
                form.querySelector('input[name="pageSize"]').value = val;
                form.submit();
            }
        }
    </script>
}

@functions {
    string GetQueryWithout(params string[] keysToExclude)
    {
        var dict = Model.Filter.ToRouteDictionary();
        foreach (var k in keysToExclude)
        {
            dict.Remove(k);
        }
        return string.Join("&", dict.Select(kvp => $"{kvp.Key}={Uri.EscapeDataString(kvp.Value ?? "")}"));
    }

    // Bỏ một lựa chọn thông số khỏi URL, giữ nguyên các bộ lọc khác
    string GetQueryWithoutSpec(string token)
    {
        var dict = Model.Filter.ToRouteDictionary();
        var remaining = (Model.Filter.Ts ?? new List<string>())
            .Where(t => !string.Equals(t, token, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (remaining.Count > 0) dict["ts"] = string.Join(",", remaining); else dict.Remove("ts");
        return string.Join("&", dict.Select(kvp => $"{kvp.Key}={Uri.EscapeDataString(kvp.Value ?? "")}"));
    }

    string GetPriceRangeLabel(string? range) => range switch
    {
        "0-1000000" => "Dưới 1 triệu",
        "1000000-5000000" => "1 – 5 triệu",
        "1000000-3000000" => "1 – 3 triệu",
        "3000000-5000000" => "3 – 5 triệu",
        "5000000-10000000" => "5 – 10 triệu",
        "10000000-20000000" => "10 – 20 triệu",
        "tren-20000000" => "Trên 20 triệu",
        _ => range ?? ""
    };
}

