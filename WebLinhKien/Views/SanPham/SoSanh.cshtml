@model WebLinhKien.Models.ViewModels.Client.CompareViewModel
@{
    ViewData["Title"] = "So sánh linh kiện máy tính - TECHZONE";
}

<div class="tz-container py-4">
    <!-- Breadcrumb -->
    <nav class="tz-breadcrumb-wrapper bg-transparent border-0 p-0 mb-3" aria-label="Breadcrumb">
        <ol class="tz-breadcrumb">
            <li class="tz-breadcrumb-item"><a href="~/"><i class="fa-solid fa-house"></i> Trang chủ</a></li>
            <li class="tz-breadcrumb-separator"><i class="fa-solid fa-chevron-right"></i></li>
            <li class="tz-breadcrumb-item"><a href="~/SanPham">Sản phẩm</a></li>
            <li class="tz-breadcrumb-separator"><i class="fa-solid fa-chevron-right"></i></li>
            <li class="tz-breadcrumb-item active">So sánh linh kiện</li>
        </ol>
    </nav>

    <div class="bg-white p-4 rounded-3 border shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">
                    <i class="fa-solid fa-code-compare text-warning me-2"></i>Bảng So Sánh Thông Số Linh Kiện
                </h1>
                <p class="text-muted small mb-0">Đối chiếu trực quan thông số phần cứng giữa tối đa 3 sản phẩm lựa chọn.</p>
            </div>
            @if (Model.SanPhams.Any())
            {
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="tzClearCompare()">
                    <i class="fa-solid fa-trash me-1"></i>Xóa toàn bộ so sánh
                </button>
            }
        </div>

        @await Html.PartialAsync("_CompareModalContent", Model)
    </div>
</div>

