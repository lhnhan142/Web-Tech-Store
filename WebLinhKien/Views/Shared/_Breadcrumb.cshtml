@model IEnumerable<WebLinhKien.Models.ViewModels.Client.BreadcrumbItem>

@if (Model != null && Model.Any())
{
    <nav class="tz-breadcrumb-wrapper" aria-label="Breadcrumb">
        <div class="tz-container">
            <ol class="tz-breadcrumb">
                <li class="tz-breadcrumb-item">
                    <a href="~/" title="Trang chủ"><i class="fa-solid fa-house"></i> Trang chủ</a>
                </li>
                @foreach (var item in Model)
                {
                    <li class="tz-breadcrumb-separator">
                        <i class="fa-solid fa-chevron-right"></i>
                    </li>
                    if (item.IsActive || string.IsNullOrEmpty(item.Url))
                    {
                        <li class="tz-breadcrumb-item active" aria-current="page">
                            <span>@item.Title</span>
                        </li>
                    }
                    else
                    {
                        <li class="tz-breadcrumb-item">
                            <a href="@Url.Content(item.Url)">@item.Title</a>
                        </li>
                    }
                }
            </ol>
        </div>
    </nav>
}

