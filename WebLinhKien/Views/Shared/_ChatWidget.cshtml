@* Khung chat tư vấn nổi ở góc phải. Nhúng vào _Layout bằng một dòng: @await Html.PartialAsync("_ChatWidget") *@
<style>
    .tzc-fab { position: fixed; right: 24px; bottom: 90px; z-index: 1080; width: 56px; height: 56px; border: 0; border-radius: 50%;
        background: #f59e0b; color: #fff; font-size: 22px; box-shadow: 0 6px 18px rgba(0,0,0,.25); cursor: pointer; }
    .tzc-box { position: fixed; right: 24px; bottom: 158px; z-index: 1080; width: 380px; max-width: calc(100vw - 24px); height: 560px; max-height: calc(100vh - 180px);
        display: none; flex-direction: column; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; box-shadow: 0 12px 36px rgba(0,0,0,.25); }
    .tzc-box.is-open { display: flex; }
    .tzc-head { padding: 12px 14px; background: #0f172a; color: #fff; font-weight: 600; display: flex; justify-content: space-between; align-items: center; }
    .tzc-head button { background: none; border: 0; color: #fff; font-size: 18px; cursor: pointer; }
    .tzc-msgs { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; background: #f8fafc; }
    .tzc-m { max-width: 92%; padding: 8px 11px; border-radius: 12px; font-size: 14px; line-height: 1.45; white-space: pre-wrap; word-wrap: break-word; }
    .tzc-m.bot { background: #fff; border: 1px solid #e2e8f0; align-self: flex-start; }
    .tzc-m.bot.wide { max-width: 100%; align-self: stretch; }
    .tzc-m.me { background: #f59e0b; color: #fff; align-self: flex-end; }

    .tzc-choices { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; white-space: normal; }
    .tzc-choice { border: 1px solid #f59e0b; color: #b45309; background: #fffbeb; border-radius: 16px; padding: 5px 11px; font-size: 13px; cursor: pointer; }
    .tzc-choice:hover { background: #f59e0b; color: #fff; }

    .tzc-card { display: flex; gap: 8px; align-items: center; padding: 6px; margin-top: 6px; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; color: #0f172a; background: #fff; white-space: normal; }
    .tzc-card img { width: 44px; height: 44px; object-fit: contain; flex: none; }
    .tzc-card b { display: block; font-size: 13px; }
    .tzc-card small { display: block; color: #64748b; font-size: 11.5px; }
    .tzc-card span { font-size: 13px; color: #dc2626; font-weight: 600; }

    .tzc-build { margin-top: 8px; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; white-space: normal; }
    .tzc-build__title { padding: 8px 10px; background: #0f172a; color: #fff; font-weight: 600; font-size: 13px; }
    .tzc-brow { display: grid; grid-template-columns: 74px 1fr auto; gap: 8px; align-items: center; padding: 7px 10px; border-top: 1px solid #f1f5f9; color: #0f172a; text-decoration: none; font-size: 12.5px; }
    .tzc-brow:hover { background: #f8fafc; }
    .tzc-brow__role { color: #64748b; font-weight: 600; font-size: 11.5px; text-transform: uppercase; }
    .tzc-brow__price { color: #dc2626; font-weight: 600; white-space: nowrap; }
    .tzc-build__sum { padding: 8px 10px; background: #fffbeb; border-top: 1px solid #fde68a; font-size: 13px; }
    .tzc-build__sum b { color: #dc2626; }
    .tzc-build__notes { margin: 0; padding: 8px 10px 8px 26px; font-size: 12px; color: #92400e; background: #fffbeb; }

    .tzc-form { display: flex; gap: 6px; padding: 10px; border-top: 1px solid #e2e8f0; }
    .tzc-form input { flex: 1; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; }
    .tzc-form button { padding: 0 14px; border: 0; border-radius: 8px; background: #0f172a; color: #fff; cursor: pointer; }
    .tzc-form button:disabled { opacity: .5; cursor: default; }
</style>

<button type="button" class="tzc-fab" id="tzcFab" aria-label="Mở chat tư vấn"><i class="fa-solid fa-comments"></i></button>
<div class="tzc-box" id="tzcBox" role="dialog" aria-label="Chat tư vấn">
    <div class="tzc-head"><span><i class="fa-solid fa-robot me-1"></i> Tư vấn linh kiện &amp; cấu hình PC</span><button type="button" id="tzcClose" aria-label="Đóng">&times;</button></div>
    <div class="tzc-msgs" id="tzcMsgs"></div>
    <form class="tzc-form" id="tzcForm" autocomplete="off">
        <input type="text" id="tzcInput" maxlength="500" placeholder="Bấm nút hoặc gõ, ví dụ: PC gaming 15 triệu" aria-label="Câu hỏi" />
        <button type="submit" id="tzcSend">Gửi</button>
    </form>
</div>

<script>
(function () {
    var box = document.getElementById('tzcBox'), msgs = document.getElementById('tzcMsgs'),
        form = document.getElementById('tzcForm'), input = document.getElementById('tzcInput'), send = document.getElementById('tzcSend');
    var history = [];     // 6 lượt gần nhất, dùng cho câu hỏi tự do
    var state = null;     // trạng thái cuộc tư vấn do server trả về, gửi lại ở lần hỏi sau

    var MENU = [
        { label: 'Tư vấn cấu hình PC', text: 'Tư vấn cấu hình PC' },
        { label: 'Tìm linh kiện theo giá và hãng', text: 'Tìm linh kiện theo giá và hãng' }
    ];

    function el(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text !== undefined && text !== null) e.textContent = text;   // textContent: không chèn HTML từ phản hồi
        return e;
    }
    function scroll() { msgs.scrollTop = msgs.scrollHeight; }
    function clearChoices() {
        var old = msgs.querySelectorAll('.tzc-choices');
        for (var i = 0; i < old.length; i++) old[i].parentNode.removeChild(old[i]);
    }

    function card(p) {
        var a = el('a', 'tzc-card'); a.href = p.url;
        if (p.anh) { var i = el('img'); i.src = p.anh; i.alt = ''; a.appendChild(i); }
        var t = el('div');
        t.appendChild(el('b', null, p.ten));
        if (p.hang) t.appendChild(el('small', null, p.hang));
        t.appendChild(el('span', null, p.gia));
        a.appendChild(t);
        return a;
    }

    function buildBlock(b) {
        var w = el('div', 'tzc-build');
        w.appendChild(el('div', 'tzc-build__title', b.title));
        (b.items || []).forEach(function (it) {
            var r = el('a', 'tzc-brow'); r.href = it.card.url;
            r.appendChild(el('span', 'tzc-brow__role', it.label));
            r.appendChild(el('span', null, it.card.ten));
            r.appendChild(el('span', 'tzc-brow__price', it.card.gia));
            w.appendChild(r);
        });
        var sum = el('div', 'tzc-build__sum');
        sum.appendChild(document.createTextNode('Tổng: '));
        sum.appendChild(el('b', null, b.total));
        sum.appendChild(document.createTextNode(' · Ngân sách: ' + b.budget + ' · ' + (b.remaining.indexOf('Vượt') === 0 ? b.remaining : 'Còn dư: ' + b.remaining)));
        w.appendChild(sum);
        if (b.notes && b.notes.length) {
            var ul = el('ul', 'tzc-build__notes');
            b.notes.forEach(function (n) { ul.appendChild(el('li', null, n)); });
            w.appendChild(ul);
        }
        return w;
    }

    function choices(list) {
        var w = el('div', 'tzc-choices');
        (list || []).forEach(function (c) {
            var b = el('button', 'tzc-choice', c.label); b.type = 'button';
            b.addEventListener('click', function () { ask(c.text, c.label); });
            w.appendChild(b);
        });
        return w;
    }

    function addUser(text) { var d = el('div', 'tzc-m me', text); msgs.appendChild(d); scroll(); }

    function fillBot(div, d) {
        div.textContent = d.answer || '';
        (d.products || []).forEach(function (p) { div.appendChild(card(p)); });
        if (d.build) { div.classList.add('wide'); div.appendChild(buildBlock(d.build)); }
        if (d.choices && d.choices.length) div.appendChild(choices(d.choices));
        scroll();
    }

    function addBot(d) { var div = el('div', 'tzc-m bot'); msgs.appendChild(div); fillBot(div, d); return div; }

    function ask(text, label) {
        text = (text || '').trim();
        if (!text || send.disabled) return;
        clearChoices();
        addUser(label || text);
        input.value = ''; send.disabled = true;
        var wait = el('div', 'tzc-m bot', 'Đang xử lý...'); msgs.appendChild(wait); scroll();
        var tokenEl = document.querySelector('#tz-antiforgery-form input[name="__RequestVerificationToken"]');

        fetch('/Chat/Hoi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': tokenEl ? tokenEl.value : '' },
            body: JSON.stringify({ message: text, history: history.slice(-6), state: state })
        }).then(function (r) {
            if (r.status === 429) throw new Error('Bạn hỏi hơi nhanh, vui lòng thử lại sau ít phút.');
            if (!r.ok) { console.error('Chat lỗi HTTP', r.status); throw new Error('Chatbot đang bận (mã ' + r.status + '), vui lòng thử lại.'); }
            return r.json();
        }).then(function (d) {
            state = d.state || null;
            fillBot(wait, d);
            history.push({ role: 'user', text: text }, { role: 'assistant', text: d.answer || '' });
        }).catch(function (err) {
            wait.textContent = err.message;
            wait.appendChild(choices(MENU));
        }).finally(function () { send.disabled = false; scroll(); });
    }

    document.getElementById('tzcFab').addEventListener('click', function () {
        box.classList.toggle('is-open');
        if (box.classList.contains('is-open') && !msgs.children.length) {
            addBot({
                answer: 'Xin chào! Mình có thể giúp bạn:\n• Ghép cấu hình PC đầy đủ theo mức giá và nhu cầu (văn phòng, gaming...)\n• Tìm linh kiện (CPU, RAM, VGA...) theo mức giá và hãng\nBạn muốn tư vấn gì?',
                choices: MENU
            });
        }
        input.focus();
    });
    document.getElementById('tzcClose').addEventListener('click', function () { box.classList.remove('is-open'); });
    form.addEventListener('submit', function (e) { e.preventDefault(); ask(input.value); });
})();
</script>
