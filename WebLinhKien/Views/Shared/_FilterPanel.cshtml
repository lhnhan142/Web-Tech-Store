@model WebLinhKien.Models.ViewModels.Client.FilterPanelViewModel
@using WebLinhKien.Models.ViewModels.Client
@using System.Globalization

@{
    var prefix = Model.IdPrefix ?? "tz";
    var formId = $"{prefix}-filter-form";
    var minInputId = $"{prefix}-min-price";
    var maxInputId = $"{prefix}-max-price";
    var brandContainerId = $"{prefix}-brand-filter-container";
    var priceValidationId = $"{prefix}-price-validation-msg";

    var priceRanges = new[]
    {
        ("", "Tất cả mức giá"),
        ("0-1000000", "Dưới 1 triệu"),
        ("1000000-5000000", "1 – 5 triệu"),
        ("5000000-10000000", "5 – 10 triệu"),
        ("10000000-20000000", "10 – 20 triệu"),
        ("tren-20000000", "Trên 20 triệu")
    };
}

<aside class="tz-filter-sidebar bg-white p-3 p-xl-4 rounded-3 border">
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
        <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.05rem;">
            <i class="fa-solid fa-filter text-warning me-2"></i>Bộ Lọc Sản Phẩm
        </h5>
        @if (Model.HasActiveFilters)
        {
            <a href="@Model.ResetUrl" class="text-danger small text-decoration-none">
                <i class="fa-solid fa-xmark"></i> Xóa
            </a>
        }
    </div>

    <form id="@formId" action="@Model.ActionUrl" method="get">
        <!-- Giữ lại từ khóa tìm kiếm nếu có -->
        @if (!string.IsNullOrEmpty(Model.Q))
        {
            <input type="hidden" name="q" value="@Model.Q" />
        }
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />

        <!-- Nhóm 1: Danh mục linh kiện -->
        <div class="tz-filter-group mb-4">
            <h6 class="tz-filter-title">Danh Mục Linh Kiện</h6>
            <div class="tz-filter-options">
                <label class="tz-filter-radio @(string.IsNullOrEmpty(Model.SelectedDanhMuc) ? "active" : "")">
                    <input type="radio" name="danhMuc" value=""
                           @(string.IsNullOrEmpty(Model.SelectedDanhMuc) ? "checked" : "")
                           onchange="onCategoryChanged_@(prefix)(this)" />
                    <span>Tất cả danh mục</span>
                </label>
                @foreach (var cat in Model.Categories)
                {
                    var isChecked = string.Equals(Model.SelectedDanhMuc, cat.MaDanhMuc, StringComparison.OrdinalIgnoreCase);
                    <label class="tz-filter-radio @(isChecked ? "active" : "")">
                        <input type="radio" name="danhMuc" value="@cat.MaDanhMuc"
                               @(isChecked ? "checked" : "")
                               onchange="onCategoryChanged_@(prefix)(this)" />
                        <span class="d-flex align-items-center gap-2">
                            <i class="fa-solid @CategoryIconHelper.GetIcon(cat.MaDanhMuc)" style="width: 14px; font-size: 0.8rem; color: #94A3B8;"></i>
                            <span>@cat.TenDanhMuc</span>
                        </span>
                    </label>
                }
            </div>
        </div>

        <!-- Nhóm 2: Thương hiệu phụ thuộc danh mục -->
        <div class="tz-filter-group mb-4">
            <h6 class="tz-filter-title">Thương Hiệu</h6>
            <div id="@brandContainerId">
                @if (string.IsNullOrEmpty(Model.SelectedDanhMuc))
                {
                    <div class="p-3 bg-light rounded-2 text-center text-muted small border">
                        <i class="fa-solid fa-arrow-up text-warning me-1"></i>
                        <span>Vui lòng chọn danh mục trước để xem các thương hiệu phù hợp.</span>
                    </div>
                }
                else if (Model.CategoryBrands.Any())
                {
                    <div class="tz-filter-options" style="max-height: 220px; overflow-y: auto;">
                        <label class="tz-filter-radio @(string.IsNullOrEmpty(Model.SelectedThuongHieu) ? "active" : "")">
                            <input type="radio" name="thuongHieu" value=""
                                   @(string.IsNullOrEmpty(Model.SelectedThuongHieu) ? "checked" : "")
                                   onchange="this.form.submit()" />
                            <span>Tất cả thương hiệu</span>
                        </label>
                        @foreach (var b in Model.CategoryBrands)
                        {
                            var isChecked = string.Equals(Model.SelectedThuongHieu, b.MaThuongHieu, StringComparison.OrdinalIgnoreCase);
                            <label class="tz-filter-radio @(isChecked ? "active" : "")">
                                <input type="radio" name="thuongHieu" value="@b.MaThuongHieu"
                                       @(isChecked ? "checked" : "")
                                       onchange="this.form.submit()" />
                                <span class="d-flex align-items-center justify-content-between w-100">
                                    <span>@b.TenThuongHieu</span>
                                    <span class="badge bg-light text-muted border fw-normal" style="font-size: 0.75rem;">@b.SoLuongSanPham</span>
                                </span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="p-3 bg-light rounded-2 text-center text-muted small border">
                        <span>Không có thương hiệu nào trong danh mục này.</span>
                    </div>
                }
            </div>
        </div>

        @if (Model.ShowPriceFilter)
        {
            <!-- Nhóm 3: Khoảng giá -->
            <div class="tz-filter-group mb-4">
                <h6 class="tz-filter-title">Khoảng Giá</h6>

                @if (!string.IsNullOrEmpty(Model.PriceErrorMessage))
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>@Model.PriceErrorMessage
                    </div>
                }

                <div class="tz-filter-options">
                    @foreach (var (val, label) in priceRanges)
                    {
                        var isChecked = string.Equals(Model.SelectedPriceRange, val, StringComparison.OrdinalIgnoreCase) ||
                                        (string.IsNullOrEmpty(Model.SelectedPriceRange) && string.IsNullOrEmpty(val) && !Model.MinPrice.HasValue && !Model.MaxPrice.HasValue);
                        <label class="tz-filter-radio @(isChecked ? "active" : "")">
                            <input type="radio" name="priceRange" value="@val"
                                   @(isChecked ? "checked" : "")
                                   onchange="onPriceRangeSelected_@(prefix)(this)" />
                            <span>@label</span>
                        </label>
                    }
                </div>

                <!-- Nhập giá tùy chỉnh -->
                <div class="mt-3 pt-3 border-top">
                    <span class="small text-muted fw-semibold d-block mb-2">Hoặc nhập khoảng giá (VNĐ):</span>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <input type="text" id="@minInputId" name="minPrice" class="form-control form-control-sm"
                               placeholder="Từ" value="@(string.IsNullOrEmpty(Model.SelectedPriceRange) && Model.MinPrice.HasValue ? Model.MinPrice.Value.ToString("N0", new CultureInfo("vi-VN")) : "")"
                               oninput="onCustomPriceInput_@(prefix)(this)" />
                        <span class="text-muted">-</span>
                        <input type="text" id="@maxInputId" name="maxPrice" class="form-control form-control-sm"
                               placeholder="Đến" value="@(string.IsNullOrEmpty(Model.SelectedPriceRange) && Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToString("N0", new CultureInfo("vi-VN")) : "")"
                               oninput="onCustomPriceInput_@(prefix)(this)" />
                    </div>
                    <div id="@priceValidationId" class="text-danger small mb-2 d-none"></div>
                    <button type="button" onclick="applyCustomPrice_@(prefix)()" class="tz-btn tz-btn-outline tz-btn-sm w-100">
                        Áp dụng giá
                    </button>
                </div>
            </div>
        }

        @if (Model.ShowStockFilter)
        {
            <!-- Nhóm 4: Tình trạng kho -->
            <div class="tz-filter-group mb-4">
                <h6 class="tz-filter-title">Tình Trạng Kho</h6>
                <label class="tz-filter-checkbox d-flex align-items-center gap-2">
                    <input type="checkbox" name="conHang" value="true"
                           @(Model.ConHang == true ? "checked" : "")
                           onchange="this.form.submit()" />
                    <span class="small fw-semibold">Chỉ hiển thị sản phẩm còn hàng</span>
                </label>
            </div>
        }

        <!-- Nút Reset bộ lọc -->
        <a href="@Model.ResetUrl" class="tz-btn tz-btn-outline w-100 text-center">
            <i class="fa-solid fa-arrows-rotate me-1"></i>Đặt lại bộ lọc
        </a>
    </form>
</aside>

<script>
    function onCategoryChanged_@(prefix)(radio) {
        const form = document.getElementById('@formId');
        if (!form) return;
        const brandRadios = form.querySelectorAll('input[name="thuongHieu"]');
        brandRadios.forEach(r => r.checked = false);
        form.submit();
    }

    function onPriceRangeSelected_@(prefix)(radio) {
        const form = document.getElementById('@formId');
        if (!form) return;
        const minInput = document.getElementById('@minInputId');
        const maxInput = document.getElementById('@maxInputId');
        if (minInput) minInput.disabled = true;
        if (maxInput) maxInput.disabled = true;
        form.submit();
    }

    function onCustomPriceInput_@(prefix)(input) {
        const form = document.getElementById('@formId');
        if (!form) return;
        const radios = form.querySelectorAll('input[name="priceRange"]');
        radios.forEach(r => {
            r.checked = false;
            r.closest('.tz-filter-radio')?.classList.remove('active');
        });

        let raw = input.value.replace(/\D/g, '');
        if (raw) {
            input.value = Number(raw).toLocaleString('vi-VN');
        } else {
            input.value = '';
        }

        const errMsg = document.getElementById('@priceValidationId');
        if (errMsg) errMsg.classList.add('d-none');
    }

    function applyCustomPrice_@(prefix)() {
        const form = document.getElementById('@formId');
        if (!form) return;
        const minInput = document.getElementById('@minInputId');
        const maxInput = document.getElementById('@maxInputId');
        const errMsg = document.getElementById('@priceValidationId');

        const minRaw = minInput && minInput.value ? minInput.value.replace(/\D/g, '') : '';
        const maxRaw = maxInput && maxInput.value ? maxInput.value.replace(/\D/g, '') : '';

        const minVal = minRaw ? Number(minRaw) : null;
        const maxVal = maxRaw ? Number(maxRaw) : null;

        if (minVal !== null && maxVal !== null && minVal > maxVal) {
            if (errMsg) {
                errMsg.textContent = 'Giá tối thiểu không được lớn hơn giá tối đa!';
                errMsg.classList.remove('d-none');
            }
            return;
        }

        if (minInput) {
            if (minRaw) minInput.value = minRaw;
            else minInput.disabled = true;
        }
        if (maxInput) {
            if (maxRaw) maxInput.value = maxRaw;
            else maxInput.disabled = true;
        }

        const radios = form.querySelectorAll('input[name="priceRange"]');
        radios.forEach(r => r.disabled = true);

        form.submit();
    }
</script>

