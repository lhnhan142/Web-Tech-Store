@using WebLinhKien.Helpers
@using WebLinhKien.Models.ViewModels.Client
@{
    var soLuongGioHang = 0;
    try
    {
        soLuongGioHang = GioHangSession.Doc(Context.Session).Sum(i => i.SoLuong);
    }
    catch { }

    var currentPath = Context.Request.Path.Value ?? "/";
    var queryDanhMuc = Context.Request.Query["danhMuc"].ToString();
    var queryThuongHieu = Context.Request.Query["thuongHieu"].ToString();
    var querySearch = Context.Request.Query["q"].ToString();

    var activeCat = "";
    var activeBrand = "";

    // 1. Kiểm tra từ Model
    if (Model is ProductListViewModel listVm)
    {
        activeCat = listVm.Filter?.DanhMuc ?? "";
        activeBrand = listVm.Filter?.ThuongHieu ?? "";
    }
    else if (Model is ProductDetailViewModel detailVm && detailVm.SanPham != null)
    {
        activeCat = detailVm.SanPham.MaDanhMuc ?? "";
        activeBrand = detailVm.SanPham.MaThuongHieu ?? "";
    }

    // 2. Fallback từ Query String và Route Values
    if (string.IsNullOrEmpty(activeCat))
    {
        activeCat = !string.IsNullOrEmpty(queryDanhMuc) ? queryDanhMuc : (ViewContext.RouteData.Values["maDanhMuc"]?.ToString() ?? "");
    }
    if (string.IsNullOrEmpty(activeBrand))
    {
        activeBrand = !string.IsNullOrEmpty(queryThuongHieu) ? queryThuongHieu : (ViewContext.RouteData.Values["maThuongHieu"]?.ToString() ?? "");
    }

    // Trang chủ chỉ sáng khi ở root "/" hoặc "/Home/Index" và không có lọc danh mục, hãng hay tìm kiếm
    var isHome = (currentPath == "/" || currentPath.Equals("/Home", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase))
                 && string.IsNullOrEmpty(activeCat)
                 && string.IsNullOrEmpty(activeBrand)
                 && string.IsNullOrEmpty(querySearch);

    var isBuildPc = currentPath.StartsWith("/BuildPc", StringComparison.OrdinalIgnoreCase);

    bool IsCatActive(string catCode) => string.Equals(activeCat, catCode, StringComparison.OrdinalIgnoreCase);
    bool IsBrandActive(string brandCode) => string.Equals(activeBrand, brandCode, StringComparison.OrdinalIgnoreCase);
}

