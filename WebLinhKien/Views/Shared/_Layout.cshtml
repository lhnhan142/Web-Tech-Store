<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - " : "")TECHZONE – PC Components Store</title>
    
    <!-- Google Fonts: Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- TECHZONE Client Design System -->
    <link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Header & Navigation -->
    @await Html.PartialAsync("_Header")

    <!-- Nội dung chính của từng View -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    @await Html.PartialAsync("_Footer")

    <!-- Toast Notification Container -->
    @await Html.PartialAsync("_Toast")

    <!-- Antiforgery Form cho các lời gọi AJAX -->
    <form id="tz-antiforgery-form" style="display:none;" aria-hidden="true">
        @Html.AntiForgeryToken()
    </form>

    <!-- 1. MODAL XEM NHANH (QUICK VIEW MODAL) -->
    <div class="modal fade" id="tzQuickViewModal" tabindex="-1" aria-labelledby="tzQuickViewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-bottom-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 pt-0" id="tz-quickview-modal-body">
                    <!-- Nội dung Ajax QuickView nạp tại đây -->
                </div>
            </div>
        </div>
    </div>

    <!-- 2. MODAL DANH SÁCH YÊU THÍCH (WISHLIST MODAL) -->
    <div class="modal fade" id="tzWishlistModal" tabindex="-1" aria-labelledby="tzWishlistModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark" id="tzWishlistModalLabel">
                        <i class="fa-solid fa-heart text-danger me-2"></i>Sản Phẩm Yêu Thích Của Bạn
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3 p-md-4" id="tz-wishlist-modal-body">
                    <!-- Danh sách yêu thích nạp từ LocalStorage -->
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="tzClearWishlist()">
                        <i class="fa-solid fa-trash me-1"></i>Xóa tất cả
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. THANH SO SÁNH NỔI DƯỚI ĐÁY MÀN HÌNH (FLOATING COMPARE BAR) -->
    <div id="tz-compare-bar" class="tz-compare-bar" style="display: none;">
        <div class="tz-container d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="tz-compare-badge">
                    <i class="fa-solid fa-code-compare me-1"></i>
                    <span>So sánh (<strong id="tz-compare-count">0</strong>/3)</span>
                </div>
                <div id="tz-compare-items-preview" class="d-flex align-items-center gap-2">
                    <!-- Danh sách ảnh nhỏ sản phẩm so sánh -->
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="tz-btn tz-btn-accent tz-btn-sm" onclick="tzOpenCompareModal()">
                    <i class="fa-solid fa-table-columns me-1"></i>
                    <span>So sánh ngay</span>
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" onclick="tzClearCompare()" title="Hủy so sánh">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- 4. MODAL BẢNG SO SÁNH SẢN PHẨM (COMPARE MODAL) -->
    <div class="modal fade" id="tzCompareModal" tabindex="-1" aria-labelledby="tzCompareModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark" id="tzCompareModalLabel">
                        <i class="fa-solid fa-code-compare text-warning me-2"></i>Bảng So Sánh Đối Chiếu Thông Số
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0" id="tz-compare-modal-body">
                    <!-- Nội dung so sánh Ajax nạp tại đây -->
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="tzClearCompare()">
                        <i class="fa-solid fa-trash me-1"></i>Xóa danh sách so sánh
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/client.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
