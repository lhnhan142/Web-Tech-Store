@model WebLinhKien.Models.ViewModels.Client.ProductDetailViewModel

<div class="row g-4">
    <!-- Cột trái: Ảnh sản phẩm -->
    <div class="col-md-5">
        <div class="tz-detail-main-img-box position-relative" style="height: 300px;">
            <div class="tz-card-badges">
                @if (Model.CoGiamGia)
                {
                    <span class="tz-badge tz-badge-discount">-@Model.PhanTramGiam%</span>
                }
                @if (Model.SanPham.NoiBat)
                {
                    <span class="tz-badge tz-badge-accent"><i class="fa-solid fa-fire"></i> HOT</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.SanPham.AnhDaiDien))
            {
                <img src="@Model.SanPham.AnhDaiDien" alt="@Model.SanPham.TenSanPham"
                     class="tz-detail-main-img" onerror="tzImgError(this)" />
                <div class="tz-thumb-fallback" style="display: none; height: 100%;">
                    <i class="fa-solid @Model.IconDanhMuc"></i>
                </div>
            }
            else
            {
                <div class="tz-thumb-fallback" style="height: 100%;">
                    <i class="fa-solid @Model.IconDanhMuc"></i>
                </div>
            }
        </div>
    </div>

    <!-- Cột phải: Thông tin nhanh -->
    <div class="col-md-7">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="tz-card-brand">@(string.IsNullOrEmpty(Model.SanPham.MaThuongHieu) ? "Chính hãng" : Model.SanPham.MaThuongHieu)</span>
            <span class="tz-card-sku">SKU: @Model.SanPham.MaSanPham</span>
        </div>

        <h4 class="fw-bold text-dark mb-2">@Model.SanPham.TenSanPham</h4>

        <!-- Tình trạng kho & Bảo hành -->
        <div class="d-flex align-items-center gap-3 mb-3 small">
            @if (Model.ConHang)
            {
                <span class="text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i>Còn hàng (@Model.SanPham.TonKho cái)</span>
            }
            else
            {
                <span class="text-danger fw-bold"><i class="fa-solid fa-circle-xmark me-1"></i>Tạm hết hàng</span>
            }
            <span class="text-muted">|</span>
            <span class="text-muted"><i class="fa-solid fa-shield text-success me-1"></i>Bảo hành @(Model.SanPham.BaoHanhThang > 0 ? $"{Model.SanPham.BaoHanhThang}T" : "12T")</span>
        </div>

        <!-- Giá bán -->
        <div class="p-3 rounded-2 mb-3 bg-light">
            <div class="d-flex align-items-baseline gap-2">
                <span class="h4 fw-bold text-danger mb-0">@Model.SanPham.GiaBan.ToVnd()</span>
                @if (Model.CoGiamGia)
                {
                    <span class="text-muted text-decoration-line-through small">@Model.SanPham.GiaGoc.ToVnd()</span>
                }
            </div>
        </div>

        <!-- Thông số tóm tắt -->
        @if (Model.ThongSo != null && Model.ThongSo.Any())
        {
            <div class="mb-3 small">
                <div class="fw-bold text-dark mb-1">Thông số kỹ thuật chính:</div>
                <ul class="list-unstyled mb-0">
                    @foreach (var ts in Model.ThongSo.Take(4))
                    {
                        <li class="d-flex align-items-center justify-content-between py-1 border-bottom">
                            <span class="text-muted">@ts.TenThongSo:</span>
                            <span class="fw-semibold text-dark">@ts.GiaTri</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- Nút Thao Tác -->
        <div class="d-flex align-items-center gap-2 mt-3">
            @if (Model.ConHang)
            {
                <button type="button" class="tz-btn tz-btn-accent flex-grow-1"
                        onclick="tzQuickViewAddToCart(@Model.SanPham.Uid)">
                    <i class="fa-solid fa-cart-plus me-1"></i>
                    <span>Thêm giỏ hàng</span>
                </button>
            }
            <a href="~/SanPham/ChiTiet/@Model.SanPham.Uid" class="tz-btn tz-btn-outline">
                <span>Xem chi tiết đầy đủ &rarr;</span>
            </a>
        </div>
    </div>
</div>

